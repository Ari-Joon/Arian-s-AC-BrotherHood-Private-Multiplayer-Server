<?xml version="1.0"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
        <!--
          The address clients will reach this server on.

          This value is BOTH the bind address and what the server advertises to
          clients, so it must be a real adapter on this machine AND reachable by
          every player. On a virtual LAN (Radmin/ZeroTier) use the address that
          adapter was assigned, e.g. 26.x.x.x. Rebuild after changing it.
        -->
        <add key="SecureServerAddress" value="YOUR.IP.HERE" />
        <!-- Pad the participant count reported for a session, so a solo lobby
             looks fuller than it is. 0 = off, and 0 is correct: this was tested
             and does NOT unlock a solo private match. The launch gate reads the
             client's own party roster ("not enough members in your group"), not
             the session slot count. Kept as the evidence for that negative. -->
        <add key="MinReportedSlots" value="0" />
        <!-- Fabricate this many party members on session creation, to test
             whether the private-lobby launch gate can be satisfied without
             real players. 0 = off. Uses Bot PIDs from the database. -->
        <add key="FakePartyMembers" value="0" />
    </appSettings>
</configuration>
